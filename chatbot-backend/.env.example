PORT=3000

# PostgreSQL installed directly on Windows; manage it with pgAdmin 4 or A5.
# Use the actual server port/user/password selected during PostgreSQL setup.
# DB_* fields take precedence over a legacy DATABASE_URL. No URL encoding needed.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=faq_hub_local
DB_POOL_MAX=20

# Ollama (model AI local)
OLLAMA_URL=http://localhost:11434
# Set generation budgets within the context window supported by your chosen model.
OLLAMA_CONTEXT_TOKENS=32768
OLLAMA_OUTPUT_TOKENS=2048



# BẮT BUỘC — dùng để ký/xác minh JWT. Tạo giá trị ngẫu nhiên bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Frontend (Vite)
VITE_API_URL=http://localhost:3000

# Cho phép widget gọi API từ các domain khác ngoài localhost:5173 khi nhúng
# trên website hoặc qua tunnel như ngrok. Nhiều domain cách nhau bằng dấu phẩy.
# *.ngrok-free.app / *.ngrok.io luôn được phép sẵn, không cần khai báo ở đây.
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Leave 0 for direct connections. Set the exact number of trusted proxy hops only
# when the backend cannot be reached except through that proxy chain.
TRUST_PROXY_HOPS=0

# Per-session limit + higher shared-IP backstop for office networks (requests/minute).
# Rate limit 0 disables the corresponding limiter. Not a throughput guarantee.
CHAT_SESSION_RATE_LIMIT=60
CHAT_IP_RATE_LIMIT=1200
CHAT_API_IP_RATE_LIMIT=6000

# Retrieval budgets; prompt/history/output should fit your model's context window.
RAG_TOP_K=8
RAG_MAX_CHUNKS=24
RAG_CONTEXT_MAX_CHARS=16000

# Uploads are processed directly before responding; MAX_CHUNKS 0 disables the chunk-count cutoff.
KNOWLEDGE_MAX_CHUNKS=0
KNOWLEDGE_IMPORT_RATE_LIMIT=60
KNOWLEDGE_FILE_MAX_MB=25
# Optional private directory for temporary uploads (never served publicly).
# KNOWLEDGE_UPLOAD_TEMP_DIR=

# Selection and answer generation share AI_RESPONSE_TIMEOUT_MS.
AI_EMBEDDING_TIMEOUT_MS=60000
AI_RESPONSE_TIMEOUT_MS=120000
DB_CONNECTION_TIMEOUT_MS=10000

# Conversation context budget (tokens, not a timeout).
AI_HISTORY_TOKEN_BUDGET=8192

# Initial application admin account is defined in database/schema.sql.

# Maximum simultaneous calls to Ollama. Busy calls return immediately.
AI_MAX_CONCURRENCY=1
